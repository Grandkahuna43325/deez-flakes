{ config, lib, pkgs, modulesPath, ... }:

{
  imports =
    [
      (modulesPath + "/installer/scan/not-detected.nix")
    ];

  boot.initrd.availableKernelModules = [ "xhci_pci" "ahci" "usbhid" "usb_storage" "uas" "sd_mod" ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ "kvm-amd" ];
  boot.extraModulePackages = [ ];
  boot.kernelParams = [ "initcall_blacklist=simpledrm_platform_driver_init" ];

  fileSystems."/" =
    {
      device = "/dev/disk/by-uuid/20008752-a077-4a75-bdf4-76acd7d0c2f2";
      fsType = "ext4";
    };

  fileSystems."/boot" =
    {
      device = "/dev/disk/by-uuid/5DA5-2B49";
      fsType = "vfat";
      options = [ "fmask=0077" "dmask=0077" ];
    };

  fileSystems."/home/grandkahuna43325/Games" = {
    device = "/dev/disk/by-uuid/ed13d344-d49f-4821-bdb9-bc51ce488c6d";
    fsType = "ext4";
    options = [ "nofail" "x-systemd.device-timeout=1s" ];
  };

  swapDevices =
    [{ device = "/dev/disk/by-uuid/1f61cfed-5d6d-4fe5-8ac8-358202a425e2"; }];

  # Enables DHCP on each ethernet and wireless interface. In case of scripted networking
